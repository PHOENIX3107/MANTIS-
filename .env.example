SYNCRO1_ENV=development
APP_NAME=SYNCRO1 Bug Tracker
APP_DOMAIN=localhost
APP_URL=http://localhost:8080/
ALLOWED_EMAIL_DOMAINS=syncro1.com,syncrosquad.com
ADMIN_EMAIL=admin@syncro1.com
ADMIN_USERNAME=syn_admin
ADMIN_INITIAL_PASSWORD=change-this-local-password-16
DEFAULT_PROJECT_NAME=SYNCRO1 Product
MAX_UPLOAD_MB=20
APP_TIMEZONE=UTC
COOKIE_SECURE=0
AWS_REGION=ap-south-1
EC2_INSTANCE_TYPE=t3.small
RDS_INSTANCE_CLASS=db.t4g.small
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mantis
DB_USER=mantis
DB_PASSWORD=mantis_local_password
MYSQL_DATABASE=mantis
MYSQL_USER=mantis
MYSQL_PASSWORD=mantis_local_password
MYSQL_ROOT_PASSWORD=change-root-local-password
UPLOAD_DIR=/var/lib/syncro1/uploads
CRYPTO_MASTER_SALT=local-only-change-me-0123456789
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=bugs@syncro1.com
