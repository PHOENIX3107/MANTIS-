server {
    listen 80 default_server;
    server_name _;
    root /var/www/mantis;
    index index.php;
    client_max_body_size ${MAX_UPLOAD_MB}m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Content-Security-Policy "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval'; frame-ancestors 'self'" always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /healthz/deep {
        allow 127.0.0.1;
        deny all;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/syncro1/scripts/healthcheck.php;
        fastcgi_param SCRIPT_NAME /syncro1/scripts/healthcheck.php;
        fastcgi_pass ${PHP_FPM_UPSTREAM};
    }

    location ~ ^/(?:login|lost_pwd_page)\.php$ {
        limit_req zone=syncro1_login burst=5 nodelay;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass ${PHP_FPM_UPSTREAM};
    }

    location ~ ^/(?:admin|config|doc|tests|scripts|build|tools|vendor|\.git)(?:/|$) {
        return 404;
    }

    location ~ ^/(?:api/rest|api/soap|mc_api\.php|rss(?:\.php)?)(?:/|$) {
        return 404;
    }

    # Upload storage is outside the web root in production; reject common
    # direct-path probes before the application can redirect them to login.
    location ~ ^/(?:uploads|var/lib/syncro1/uploads|syncro1/uploads)(?:/|$) {
        return 404;
    }

    location ~* /(?:composer\.(?:json|lock)|.*\.sql|.*\.log)$ {
        return 404;
    }

    location ~* \.(?:php[0-9]?|phtml|phar)$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass ${PHP_FPM_UPSTREAM};
    }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
