project_name       = "syncro1"
aws_region         = "ap-south-1"
ec2_instance_type  = "t3.small"
rds_instance_class = "db.t4g.small"
app_domain         = "bugs.syncro1.com"
mail_from_domain   = "syncro1.com"

# Set this only when you intentionally want Terraform to create SecureStrings.
# Prefer pre-created parameters and pass their ARNs through ssm_parameter_arns.
create_ssm_parameters = false

